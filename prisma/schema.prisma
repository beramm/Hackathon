generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProductRequirement {
  id               String   @id @default(uuid())
  productName      String
  requirementsJson Json
  createdAt        DateTime @default(now())

  @@map("product_requirements")
}
